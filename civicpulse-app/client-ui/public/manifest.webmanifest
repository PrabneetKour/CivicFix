    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Report an issue", "short_name": "Report", "url": "/report", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Issue map", "short_name": "Map", "url": "/map", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
