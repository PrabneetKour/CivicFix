{
  "name": "CivicFix — civic issue register",
  "short_name": "CivicFix",
  "description": "Report street-level civic issues with photo evidence and GPS, back your neighbours' reports, and track what the ward office is doing about them.",
  "id": "/",
  "start_url": "/map",
  "scope": "/",
  "display": "standalone",
