# Copy to .env and edit
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicfix
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Deployment only. Leave blank locally.
# The origin of the deployed client, so CORS can be locked to it.
#   https://civicfix.vercel.app
CLIENT_ORIGIN=

# Photo and video storage. Blank means the local disk, which is right for development
# and wrong for any host that wipes its filesystem on restart — which is all of them.
# Copy the "API environment variable" from your Cloudinary dashboard:
#   cloudinary://key:secret@cloud-name
CLOUDINARY_URL=

# Evidence rules. Set either to false if a venue's devices cannot meet them.
# REQUIRE_GEOTAG rejects photos with no EXIF GPS tag; note that photos taken
# through a browser's camera never carry one, only the phone's own camera app.
# Google sign-in. Leave blank and the button simply does not appear.
# Create the ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Phone-friendly defaults.
# Android's browser strips EXIF location from any photo picked through a file input, so a
# web app cannot require a geotag and still work on a phone. Device GPS, captured at the
# moment of filing, is the primary signal instead. Set these to true when uploading from
# a computer, where EXIF survives.
REQUIRE_GEOTAG=false
REQUIRE_VIDEO=false

# Reject a report whose pin sits inside a private plot rather than on public land.
# The check uses OpenStreetMap via Overpass and fails open if that service is down.
REQUIRE_PUBLIC_LAND=true

# How far the photo's own GPS tag may sit from the device's reading before the report
# is refused as inconsistent, in metres. Generous on purpose: photographing an issue and
# filing it later from home is normal. Set 0 to switch the check off.
MAX_EXIF_DRIFT_M=2000

# How old the photo may be, in hours, judged by the camera's own capture timestamp.
# This is what stops recycled and stale pictures now that the radius is wide.
# Set 0 to switch the check off.
MAX_PHOTO_AGE_HOURS=24

# Created by `npm run setup`
ADMIN_NAME=Ward Office
ADMIN_EMAIL=admin@city.gov
ADMIN_PASSWORD=admin123

# Only used by `npm run setup:demo` to place sample issues
DEMO_LAT=19.9975
DEMO_LNG=73.7898
